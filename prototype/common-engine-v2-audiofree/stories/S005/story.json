  "scenes": {
    "scene01": {
      "steps": [
        {
          "type": "clear"
        },
        {
          "type": "scene",
          "asset": "images/005/reference-v1/Scene1.png"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "夕方、一行が新しい町に着く。"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "町は一見普通だが、店を早めに閉める人が多く、どこか落ち着かない。"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "突然――"
        },
        {
          "type": "line",
          "speaker": "Kong",
          "text": "What was that?",
          "supportText": "今のは何だ？"
        },
        {
          "type": "scene",
          "asset": "images/005/ben_town_night_anomaly.png"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "振り向く。"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "何も見えない。"
        },
        {
          "type": "line",
          "speaker": "Kong",
          "text": "Nothing!",
          "supportText": "何もない！"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "町の女性が言う。"
        },
        {
          "type": "line",
          "speaker": "Woman",
          "text": "Be careful.",
          "supportText": "気をつけて。"
        },
        {
          "type": "line",
          "speaker": "Kong",
          "text": "Why?",
          "supportText": "どうして？"
        },
        {
          "type": "line",
          "speaker": "Woman",
          "text": "Strange things happen at night.",
          "supportText": "夜になると変なことが起きるの。"
        },
        {
          "type": "line",
          "speaker": "Townsperson",
          "text": "We hear footsteps.",
          "supportText": "足音が聞こえるんだ。"
        },
        {
          "type": "line",
          "speaker": "Woman",
          "text": "But we can’t see anything.",
          "supportText": "でも、何も見えないの。"
        },
        {
          "type": "line",
          "speaker": "Townsperson",
          "text": "Maybe a ghost.",
          "supportText": "幽霊かもしれない。"
        },
        {
          "type": "line",
          "speaker": "Townsperson",
          "text": "Or a thief.",
          "supportText": "それとも泥棒かも。"
        },
        {
          "type": "line",
          "speaker": "Pico",
          "text": "最近、この町では夜になると変なことが起きるみたいだピコ。"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "そこへ別の女性が慌てて走ってくる。"
        },
        {
          "type": "scene",
          "asset": "images/005/clean-v1/missing-bag-report.png"
        },
        {
          "type": "line",
          "speaker": "Woman 2",
          "text": "My bag was gone!",
          "supportText": "バッグがなくなったの！"
        },
        {
          "type": "line",
          "speaker": "Woman 2",
          "text": "Someone stole it!",
          "supportText": "誰かが盗んだのよ！"
        },
        {
          "type": "line",
          "speaker": null,
          "text": "女性は交番へ向かう。"
        },
        {
          "type": "line",
          "speaker": "Pico",
          "text": "なんだか物騒な町だピコ……。"
        },
        {
          "type": "goto",
          "to": "scene02"
        }
      ]
    },
    "scene02": {
      "steps": [
        {
